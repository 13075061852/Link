{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "link-cloudflare",
  "main": "./worker.js",
  "compatibility_date": "2026-05-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "link_store",
      "database_id": "65d61eda-4db4-413d-b832-2636c6849568"
    }
  ]
}
